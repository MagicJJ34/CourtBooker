@{
    ViewData["Title"] = "Logowanie";
}

<div class="row justify-content-center align-items-center my-5">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-dark-emerald text-white text-center py-4 border-0">
                <i class="bi bi-shield-lock fs-1 text-emerald"></i>
                <h4 class="fw-bold mt-2 mb-0">Zaloguj się</h4>
                <p class="text-white-50 small mb-0">Wprowadź dane, aby przejść do panelu</p>
            </div>
            <div class="card-body p-4 bg-white">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Adres Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input name="email" class="form-control bg-light border-start-0"
                                   type="email" placeholder="nazwa@example.com" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-secondary">Hasło</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-key"></i>
                            </span>
                            <input id="Password" name="password"
                                   class="form-control bg-light border-start-0"
                                   type="password" placeholder="••••••••" required />
                            <button type="button" class="btn btn-outline-secondary"
                                    aria-label="Pokaż hasło"
                                    onclick="togglePassword('Password', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-emerald text-white w-100 py-2 rounded-pill fw-semibold shadow-sm mb-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Zaloguj się
                    </button>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3 border-0">
                <span class="small text-muted">Nie masz jeszcze konta?</span>
                <a asp-action="Register" class="small fw-bold text-emerald text-decoration-none ms-1">
                    Zarejestruj się
                </a>
            </div>
        </div>
    </div>
</div>
