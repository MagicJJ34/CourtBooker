@model CourtBooker.Models.ProfileViewModel

@{
    ViewData["Title"] = "Moje konto";
}

<div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width:650px">
    <div class="card-body p-4">
        <h3 class="fw-bold mb-4">
            <i class="bi bi-person-circle text-success"></i> Moje konto
        </h3>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <form asp-action="Profile" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <h5>Dane osobowe</h5>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Imię i nazwisko</label>
                <input asp-for="Name" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Adres e-mail</label>
                <input asp-for="Email" class="form-control" />
            </div>

            <hr class="my-4" />

            <h5>Zmiana hasła</h5>
            <p class="text-muted small">
                Pozostaw puste, jeśli nie chcesz zmieniać hasła.
            </p>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label">
                    Obecne hasło
                </label>
                <div class="input-group">
                    <input asp-for="CurrentPassword" type="password"
                           class="form-control" />
                    <button type="button" class="btn btn-outline-secondary"
                            aria-label="Pokaż hasło"
                            onclick="togglePassword('CurrentPassword', this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">
                    Nowe hasło
                </label>
                <div class="input-group">
                    <input asp-for="NewPassword" type="password"
                           class="form-control" />
                    <button type="button" class="btn btn-outline-secondary"
                            aria-label="Pokaż hasło"
                            onclick="togglePassword('NewPassword', this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">
                    Powtórz nowe hasło
                </label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" type="password"
                           class="form-control" />
                    <button type="button" class="btn btn-outline-secondary"
                            aria-label="Pokaż hasło"
                            onclick="togglePassword('ConfirmPassword', this)">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-emerald text-white px-4">
                Zapisz zmiany
            </button>
        </form>
    </div>
</div>
