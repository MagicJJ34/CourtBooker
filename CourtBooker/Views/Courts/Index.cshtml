@model IEnumerable<CourtBooker.Models.Court>

@{
    ViewData["Title"] = "Lista Kortów";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Lista Kortów Tenisowych</h2>
    <div>
        <a asp-controller="Reservations" asp-action="Index" class="btn btn-info me-2">Lista Rezerwacji</a>
        <a asp-action="Create" class="btn btn-primary">Dodaj nowy kort</a>
    </div>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Nazwa</th>
            <th>Nawierzchnia</th>
            <th>Cena za godzinę</th>
            <th class="text-end">Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Surface</td>
                <td>@item.PricePerHour.ToString("C")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1">Edytuj</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Usuń</a>
                </td>
            </tr>
        }
    </tbody>
</table>