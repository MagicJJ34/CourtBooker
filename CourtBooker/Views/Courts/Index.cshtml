@model IEnumerable<CourtBooker.Models.Court>

@{
    ViewData["Title"] = "Zarządzanie Krtami";
}

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h3 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-dribbble text-emerald me-2"></i> Lista Kortów
                </h3>
                <p class="text-muted small mb-0">Zarządzaj dostępnymi obiektami i stawkami godzinowymi</p>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-emerald text-white rounded-pill px-4 shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Dodaj nowy kort
                </a>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark bg-dark-emerald text-white">
                    <tr>
                        <th class="py-3 px-3 rounded-start">Nazwa Kortu</th>
                        <th class="py-3">Nawierzchnia</th>
                        <th class="py-3">Cena za godzinę</th>
                        <th class="py-3 text-end px-3 rounded-end">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold px-3">
                                <i class="bi bi-geo-alt text-emerald me-1"></i> @item.Name
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.Surface
                                </span>
                            </td>
                            <td class="fw-bold text-success">
                                @item.PricePerHour.ToString("N2") zł
                            </td>
                            <td class="text-end px-3">
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill me-1 px-3">
                                            <i class="bi bi-pencil me-1"></i> Edytuj
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            <i class="bi bi-trash me-1"></i> Usuń
                                        </a>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>