@model CourtBooker.Models.Court

@{
    ViewData["Title"] = "Edytuj Kort";
}

<h2>Edycja Kortu</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group mb-3">
        <label class="control-label">Nazwa kortu</label>
        <input asp-for="Name" class="form-control" required />
    </div>
    <div class="form-group mb-3">
        <label class="control-label">Nawierzchnia</label>
        <input asp-for="Surface" class="form-control" required />
    </div>
    <div class="form-group mb-3">
        <label class="control-label">Cena za godzinę (PLN)</label>
        <input asp-for="PricePerHour" class="form-control" type="number" step="0.01" required />
    </div>
    <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
    <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
</form>