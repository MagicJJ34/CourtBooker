@model CourtBooker.Models.EditUserViewModel

@{
    ViewData["Title"] = "Edycja użytkownika";
}

<div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width:650px">
    <div class="card-body p-4">
        <h3 class="fw-bold mb-4">
            <i class="bi bi-person-gear text-success"></i>
            Edycja użytkownika
        </h3>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">
                    Imię i nazwisko
                </label>
                <input asp-for="Name" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Adres e-mail
                </label>
                <input asp-for="Email" type="email" class="form-control" />
            </div>

            <div class="mb-4">
                <label asp-for="Role" class="form-label">Rola</label>
                <select asp-for="Role" class="form-select">
                    <option value="User">Użytkownik</option>
                    <option value="Admin">Administrator</option>
                </select>
            </div>

            <div class="alert alert-light border">
                <i class="bi bi-shield-lock text-success"></i>
                Hasło użytkownika jest chronione i nie może być
                wyświetlone ani zmienione w tym formularzu.
            </div>

            <button type="submit" class="btn btn-emerald text-white">
                Zapisz zmiany
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                Anuluj
            </a>
        </form>
    </div>
</div>
