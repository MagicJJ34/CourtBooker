@model IEnumerable<CourtBooker.Models.User>
@using System.Security.Claims

@{
    ViewData["Title"] = "Użytkownicy";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0">
                <i class="bi bi-people text-success"></i>
                Zarządzanie użytkownikami
            </h3>

            <a asp-action="Create"
               class="btn btn-emerald text-white rounded-pill">
                <i class="bi bi-person-plus"></i>
                Dodaj użytkownika
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert" aria-label="Zamknij"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert" aria-label="Zamknij"></button>
            </div>
        }

        <p class="text-muted">
            Liczba użytkowników: <strong>@Model.Count()</strong>
        </p>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Imię i nazwisko</th>
                        <th>Adres e-mail</th>
                        <th>Rola</th>
                        <th>Status</th>
                        <th class="text-end">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Email</td>
                            <td>
                                @if (item.Role == "Admin")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Administrator
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Użytkownik
                                    </span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Aktywny</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Nieaktywny</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> Edytuj
                                    </a>

                                    @if (item.Id.ToString() != currentUserId)
                                    {
                                        <form asp-action="ToggleActive"
                                              asp-route-id="@item.Id" method="post">
                                            @if (item.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning"
                                                        onclick="return confirm('Dezaktywować konto tego użytkownika?')">
                                                    <i class="bi bi-person-x"></i>
                                                    Dezaktywuj
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-person-check"></i>
                                                    Aktywuj
                                                </button>
                                            }
                                        </form>

                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Usuń
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <p class="text-center text-muted mt-4">
                Brak użytkowników.
            </p>
        }
    </div>
</div>
