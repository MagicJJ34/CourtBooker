@model IEnumerable<CourtBooker.Models.User>

@{
    ViewData["Title"] = "Użytkownicy";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Lista Użytkowników</h2>
    <a asp-action="Create" class="btn btn-success">Dodaj Użytkownika</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Imię i Nazwisko</th>
            <th>Email</th>
            <th>Rola</th>
            <th class="text-end">Akcje (Admin)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td><span class="badge bg-secondary">@item.Role</span></td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edytuj</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Usuń</a>
                </td>
            </tr>
        }
    </tbody>
</table>