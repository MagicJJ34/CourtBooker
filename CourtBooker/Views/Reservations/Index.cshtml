@model IEnumerable<CourtBooker.Models.Reservation>

@{
    ViewData["Title"] = "Rezerwacje";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@(User.IsInRole("Admin") ? "Wszystkie Rezerwacje" : "Moje Rezerwacje")</h2>
    <a asp-action="Create" class="btn btn-success">Zarezerwuj kort</a>
</div>

<table class="table table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Kort</th>
            <th>Użytkownik</th>
            <th>Data</th>
            <th>Godziny</th>
            <th>Koszt</th>
            <th>Status</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Court?.Name</td>
                <td>
                    <strong>@(string.IsNullOrEmpty(item.User?.Name) ? "Brak imienia" : item.User.Name)</strong>
                    <br />
                    <small class="text-muted">@item.User?.Email</small>
                </td>
                <td>@item.Date.ToString("dd.MM.yyyy")</td>
                <td>@item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")</td>
                <td>@item.TotalPrice.ToString("N2") zł</td>
                <td>
                    <span class="badge @(item.Status switch {
                        "Confirmed" => "bg-success",
                        "In Progress" => "bg-primary",
                        "Completed" => "bg-secondary",
                        "Zakończona" => "bg-secondary",
                        "Cancelled" => "bg-danger",
                        "Anulowano" => "bg-danger",
                        _ => "bg-warning text-dark"
                    })">
                        @item.Status
                    </span>
                </td>
                <td>
                    <div class="btn-group">
                        @if (item.InternalStatus != "Cancelled" && item.Status != "Zakończona" && item.Status != "Completed")
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">Edytuj</a>
                        }

                        @if (User.IsInRole("Admin") || (item.InternalStatus != "Cancelled" && item.Status != "Zakończona" && item.Status != "Completed"))
                        {
                            <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Czy na pewno chcesz anulować tę rezerwację?')">
                                    Anuluj
                                </button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>