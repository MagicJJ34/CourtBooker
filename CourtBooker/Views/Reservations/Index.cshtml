@model IEnumerable<CourtBooker.Models.Reservation>

@{
    ViewData["Title"] = "Rezerwacje";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Wszystkie Rezerwacje</h2>
    <a asp-action="Create" class="btn btn-success">Zarezerwuj kort</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Kort</th>
            <th>Użytkownik</th>
            <th>Data</th>
            <th>Godziny</th>
            <th>Koszt</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Court?.Name</td>
                <td>@item.User?.Email</td>
                <td>@item.Date.ToString("dd.MM.yyyy")</td>
                <td>@item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")</td>
                <td>@item.TotalPrice.ToString("C")</td>
                <td><span class="badge bg-warning text-dark">@item.Status</span></td>
            </tr>
        }
    </tbody>
</table>