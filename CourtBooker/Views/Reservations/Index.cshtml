@model IEnumerable<CourtBooker.Models.Reservation>

@{
    ViewData["Title"] = "Rezerwacje";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold">
                <i class="bi bi-calendar-check text-success"></i>
                @(isAdmin ? "Zarządzanie rezerwacjami" : "Moje rezerwacje")
            </h3>
            <a asp-action="Create" class="btn btn-emerald text-white rounded-pill">
                Nowa rezerwacja
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Kort</th>
                        @if (isAdmin)
                        {
                            <th>Użytkownik</th>
                        }
                        <th>Data</th>
                        <th>Godziny</th>
                        <th>Cena</th>
                        <th>Status</th>
                        <th>Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        bool canManage = item.InternalStatus != "Cancelled" &&
                        (isAdmin || item.Date.ToDateTime(item.StartTime) > DateTime.Now);

                        <tr>
                            <td>@item.Court?.Name</td>
                            @if (isAdmin)
                            {
                                <td>@item.User?.Email</td>
                            }
                            <td>@item.Date.ToString("dd.MM.yyyy")</td>
                            <td>
                                @item.StartTime.ToString("HH:mm") -
                                @item.EndTime.ToString("HH:mm")
                            </td>
                            <td>@item.TotalPrice.ToString("N2") zł</td>
                            <td>
                                @if (item.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">Anulowana</span>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="badge bg-secondary">Zakończona</span>
                                }
                                else if (item.Status == "In Progress")
                                {
                                    <span class="badge bg-primary">W trakcie</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Aktywna</span>
                                }
                            </td>
                            <td>
                                @if (canManage)
                                {
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Edytuj
                                        </a>
                                        <form asp-action="Cancel" asp-route-id="@item.Id"
                                              method="post"
                                              onsubmit="return confirm('Anulować rezerwację?')">
                                            <button class="btn btn-sm btn-outline-danger">
                                                Anuluj
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">Brak akcji</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <p class="text-center text-muted mt-4">Brak rezerwacji.</p>
        }
    </div>
</div>
