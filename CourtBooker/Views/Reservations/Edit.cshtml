@model CourtBooker.Models.Reservation

@{
    ViewData["Title"] = "Edycja Rezerwacji";

    var timeSlots = new List<SelectListItem>();
    for (int hour = 6; hour <= 22; hour++)
    {
        var t1 = new TimeOnly(hour, 0).ToString("HH:mm");
        timeSlots.Add(new SelectListItem { Text = t1, Value = t1, Selected = (Model.StartTime.ToString("HH:mm") == t1) });

        if (hour < 22)
        {
            var t2 = new TimeOnly(hour, 30).ToString("HH:mm");
            timeSlots.Add(new SelectListItem { Text = t2, Value = t2, Selected = (Model.StartTime.ToString("HH:mm") == t2) });
        }
    }
}

<h2>Edycja Rezerwacji</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Status" />
    @if (!User.IsInRole("Admin"))
    {
        <input type="hidden" asp-for="UserId" />
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="form-group mb-3">
        <label class="control-label">Wybierz Kort</label>
        <select asp-for="CourtId" class="form-select" asp-items="ViewBag.CourtId"></select>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="form-group mb-3">
            <label class="control-label">Wybierz Użytkownika</label>
            <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId"></select>
        </div>
    }

    <div class="form-group mb-3">
        <label class="control-label">Data rezerwacji</label>
        <input asp-for="Date" class="form-control" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="control-label">Początek rezerwacji</label>
        <select asp-for="StartTime" class="form-select" asp-items="timeSlots"></select>
        <span asp-validation-for="StartTime" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="control-label">Koniec rezerwacji</label>
        <select asp-for="EndTime" class="form-select" asp-items="timeSlots"></select>
        <span asp-validation-for="EndTime" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-warning">Zapisz zmiany</button>
    <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
</form>