@model CourtBooker.Models.Reservation
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edycja rezerwacji";

    var timeSlots = new List<SelectListItem>();

    for (int hour = 6; hour <= 22; hour++)
    {
        foreach (int minute in new[] { 0, 30 })
        {
            if (hour == 22 && minute == 30)
                continue;

            var time = new TimeOnly(hour, minute).ToString("HH:mm");
            timeSlots.Add(new SelectListItem { Text = time, Value = time });
        }
    }
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <h3 class="fw-bold mb-4">Edycja rezerwacji</h3>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Kort</label>
                <select asp-for="CourtId" asp-items="ViewBag.CourtId"
                        class="form-select"></select>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="mb-3">
                    <label class="form-label">Użytkownik</label>
                    <select asp-for="UserId" asp-items="ViewBag.UserId"
                            class="form-select"></select>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Data</label>
                <input asp-for="Date" type="date" class="form-control"
                       value="@Model.Date.ToString("yyyy-MM-dd")" />
            </div>

            <div class="mb-3">
                <label class="form-label">Godzina rozpoczęcia</label>
                <select asp-for="StartTime" asp-items="timeSlots"
                        class="form-select"></select>
            </div>

            <div class="mb-3">
                <label class="form-label">Godzina zakończenia</label>
                <select asp-for="EndTime" asp-items="timeSlots"
                        class="form-select"></select>
            </div>

            <button type="submit" class="btn btn-emerald text-white">
                Zapisz zmiany
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                Powrót
            </a>
        </form>
    </div>
</div>
