@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsActive(string targetController, string? targetAction = null)
    {
        return controller.Equals(targetController, StringComparison.OrdinalIgnoreCase)
            && (targetAction == null ||
                action.Equals(targetAction, StringComparison.OrdinalIgnoreCase));
    }

    string NavClass(string targetController, string? targetAction = null)
    {
        return IsActive(targetController, targetAction)
            ? "nav-link active"
            : "nav-link";
    }

    bool isLoggedIn = User.Identity?.IsAuthenticated == true;
    bool isAdmin = User.IsInRole("Admin");

    bool adminSectionActive =
        IsActive("Dashboard") ||
        IsActive("Users") ||
        IsActive("Reports");
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1a252c" />

    <title>@ViewData["Title"] - CourtBooker</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        .courtbooker-navbar {
            background-color: #1a252c;
            padding: 0.8rem 0;
        }

            .courtbooker-navbar .navbar-brand {
                font-size: 1.5rem;
                letter-spacing: -0.5px;
                white-space: nowrap;
            }

            .courtbooker-navbar .nav-link {
                display: flex;
                align-items: center;
                gap: 0.45rem;
                padding: 0.65rem 0.8rem;
                color: #c5d0d4;
                font-size: 0.92rem;
                font-weight: 500;
                white-space: nowrap;
                border-radius: 9px;
                transition: background-color 0.2s ease, color 0.2s ease;
            }

                .courtbooker-navbar .nav-link:hover,
                .courtbooker-navbar .nav-link:focus-visible {
                    color: #ffffff;
                    background-color: rgba(255, 255, 255, 0.08);
                }

                .courtbooker-navbar .nav-link.active {
                    color: #ffffff;
                    background-color: rgba(25, 135, 84, 0.23);
                    font-weight: 600;
                }

                .courtbooker-navbar .nav-link i {
                    font-size: 1rem;
                    color: #70a995;
                }

            .courtbooker-navbar .dropdown-menu {
                border: 1px solid #e6ece9;
                border-radius: 12px;
                padding: 0.5rem;
                min-width: 220px;
                box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
            }

            .courtbooker-navbar .dropdown-item {
                display: flex;
                align-items: center;
                gap: 0.65rem;
                padding: 0.7rem 0.85rem;
                border-radius: 8px;
                font-size: 0.92rem;
            }

                .courtbooker-navbar .dropdown-item:hover,
                .courtbooker-navbar .dropdown-item:focus,
                .courtbooker-navbar .dropdown-item.active {
                    background-color: #e8f5ee;
                    color: #0f5132;
                }

                .courtbooker-navbar .dropdown-item.active {
                    font-weight: 600;
                }

                .courtbooker-navbar .dropdown-item i {
                    color: #198754;
                }

            .courtbooker-navbar .user-info {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                color: #e2e9e7;
                font-size: 0.88rem;
                white-space: nowrap;
            }

                .courtbooker-navbar .user-info i {
                    color: #198754;
                    font-size: 1.15rem;
                }

            .courtbooker-navbar .logout-btn {
                white-space: nowrap;
                padding: 0.5rem 1rem;
            }

        @@media (max-width: 1199.98px) {
            .courtbooker-navbar .navbar-collapse {
                padding-top: 1rem;
                max-height: calc(100vh - 85px);
                overflow-y: auto;
            }

            .courtbooker-navbar .nav-link {
                padding: 0.75rem 0.9rem;
            }

            .courtbooker-navbar .navbar-nav {
                gap: 0.2rem;
            }

            .courtbooker-navbar .dropdown-menu {
                border: none;
                box-shadow: none;
                background-color: rgba(255, 255, 255, 0.05);
                padding: 0.3rem 0.5rem;
                margin-bottom: 0.5rem;
            }

            .courtbooker-navbar .dropdown-item {
                color: #e2e9e7;
            }

                .courtbooker-navbar .dropdown-item:hover,
                .courtbooker-navbar .dropdown-item:focus,
                .courtbooker-navbar .dropdown-item.active {
                    background-color: rgba(25, 135, 84, 0.2);
                    color: #ffffff;
                }

            .courtbooker-navbar .user-section {
                border-top: 1px solid rgba(255, 255, 255, 0.12);
                padding-top: 1rem;
                margin-top: 0.75rem;
            }

            .courtbooker-navbar .user-info {
                padding: 0.5rem 0.9rem;
            }

            .courtbooker-navbar .logout-btn {
                width: 100%;
                margin-top: 0.5rem;
            }
        }
    </style>
</head>

<body class="bg-light d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-xl navbar-dark courtbooker-navbar shadow-sm"
             aria-label="Nawigacja główna">

            <div class="container-fluid px-3 px-xl-4">

                <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="bi bi-circle-square text-emerald"
                       aria-hidden="true"></i>

                    <span class="text-white">
                        Court<span class="text-emerald">Booker</span>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Otwórz menu nawigacyjne">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav align-items-xl-center gap-xl-1 ms-xl-4">

                        <li class="nav-item">
                            <a class="@NavClass("Home", "Index")"
                               asp-controller="Home"
                               asp-action="Index"
                               aria-current="@(IsActive("Home", "Index") ? "page" : null)">
                                <i class="bi bi-house-door" aria-hidden="true"></i>
                                Strona główna
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="@NavClass("Courts", "Index")"
                               asp-controller="Courts"
                               asp-action="Index"
                               aria-current="@(IsActive("Courts", "Index") ? "page" : null)">
                                <i class="bi bi-grid" aria-hidden="true"></i>
                                Korty
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="@NavClass("Reservations", "Calendar")"
                               asp-controller="Reservations"
                               asp-action="Calendar"
                               aria-current="@(IsActive("Reservations", "Calendar") ? "page" : null)">
                                <i class="bi bi-calendar3" aria-hidden="true"></i>
                                Kalendarz
                            </a>
                        </li>

                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Reservations", "Index")"
                                   asp-controller="Reservations"
                                   asp-action="Index"
                                   aria-current="@(IsActive("Reservations", "Index") ? "page" : null)">
                                    <i class="bi bi-calendar-check" aria-hidden="true"></i>
                                    @(isAdmin ? "Rezerwacje" : "Moje rezerwacje")
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="@NavClass("Account", "Profile")"
                                   asp-controller="Account"
                                   asp-action="Profile"
                                   aria-current="@(IsActive("Account", "Profile") ? "page" : null)">
                                    <i class="bi bi-person" aria-hidden="true"></i>
                                    Moje konto
                                </a>
                            </li>

                            @if (isAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @(adminSectionActive ? "active" : "")"
                                       href="#"
                                       id="adminDropdown"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        <i class="bi bi-gear" aria-hidden="true"></i>
                                        Administracja
                                    </a>

                                    <ul class="dropdown-menu"
                                        aria-labelledby="adminDropdown">

                                        <li>
                                            <a class="dropdown-item @(IsActive("Dashboard") ? "active" : "")"
                                               asp-controller="Dashboard"
                                               asp-action="Index">
                                                <i class="bi bi-speedometer2" aria-hidden="true"></i>
                                                Panel administratora
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item @(IsActive("Courts") ? "active" : "")"
                                               asp-controller="Courts"
                                               asp-action="Index">
                                                <i class="bi bi-grid" aria-hidden="true"></i>
                                                Zarządzanie kortami
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item @(IsActive("Users") ? "active" : "")"
                                               asp-controller="Users"
                                               asp-action="Index">
                                                <i class="bi bi-people" aria-hidden="true"></i>
                                                Użytkownicy
                                            </a>
                                        </li>

                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>

                                        <li>
                                            <a class="dropdown-item @(IsActive("Reports") ? "active" : "")"
                                               asp-controller="Reports"
                                               asp-action="Index">
                                                <i class="bi bi-bar-chart" aria-hidden="true"></i>
                                                Raporty
                                            </a>
                                        </li>

                                    </ul>
                                </li>
                            }
                        }

                    </ul>

                    <ul class="navbar-nav align-items-xl-center gap-xl-3 ms-xl-auto user-section">

                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <div class="user-info">
                                    <i class="bi bi-person-circle"
                                       aria-hidden="true"></i>

                                    <span>@User.Identity?.Name</span>

                                    @if (isAdmin)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Admin
                                        </span>
                                    }
                                </div>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    <button type="submit"
                                            class="btn btn-outline-light rounded-pill logout-btn">
                                        <i class="bi bi-box-arrow-right me-1"
                                           aria-hidden="true"></i>
                                        Wyloguj
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Account", "Login")"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"
                                       aria-hidden="true"></i>
                                    Zaloguj się
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-emerald text-white rounded-pill px-3"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    <i class="bi bi-person-plus me-1"
                                       aria-hidden="true"></i>
                                    Zarejestruj się
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer bg-white border-top py-3 text-muted text-center mt-auto">
        <div class="container small">
            &copy; @DateTime.Now.Year CourtBooker — System Rezerwacji Kortów Online
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function togglePassword(id, button) {
            const input = document.getElementById(id);

            if (!input || !button) return;

            const show = input.type === "password";
            input.type = show ? "text" : "password";

            const icon = button.querySelector("i");

            if (icon) {
                icon.className = show
                    ? "bi bi-eye-slash"
                    : "bi bi-eye";
            }

            button.setAttribute(
                "aria-label",
                show ? "Ukryj hasło" : "Pokaż hasło"
            );
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
